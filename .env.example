# npm run setup generates strong, distinct codes and AUTH_SECRET in .env.local.
# All values are server-only. Never add NEXT_PUBLIC_ to these names.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
AUTH_SECRET=replace-with-generated-secret-at-least-32-characters
STUDY_MEMBER_1_NAME="스터디원 1"
STUDY_MEMBER_1_CODE=replace-with-generated-personal-code-1
STUDY_MEMBER_2_NAME="스터디원 2"
STUDY_MEMBER_2_CODE=replace-with-generated-personal-code-2
